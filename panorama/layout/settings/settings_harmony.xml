<root>
	<styles>
		<include src="file://{resources}/styles/csgostyles.css" />
		<include src="file://{resources}/styles/settings/settings.css" />
		<include src="file://{resources}/styles/mainmenu.css" />
		<include src="file://{resources}/styles/mainmenu_inventory.css" />
	</styles>

	<scripts>
		<include src="file://{resources}/scripts/settingsmenu_shared.js" />
	</scripts>

	<Panel useglobalcontext="true" class="SettingsMenuTab">

		<Panel class="content-navbar content-navbar--short">
			<Panel id="GameModeSelectionRadios" class="content-navbar__tabs content-navbar__tabs--small">
				<RadioButton onactivate="SettingsMenuShared.ScrollToId('HarmonySettings')" group="SettingsHarmony">
					<Label class="" text="#Harmony_Viewmodel" />
				</RadioButton>

			</Panel>
		</Panel>

		<Panel class="SettingsMenuTabContent vscroll">
			<Panel id="HarmonySettings" class="SettingsBackground">
				<Panel class="SettingsSectionTitleContianer">
					<Label class="SettingsSectionTitleLabel" text="#Harmony_Viewmodel" />
				</Panel>
				<Panel class="top-bottom-flow full-width">
					<TooltipPanel id="HarmonyRightHandSelector" class="SettingsMenuDropdownContainer" tooltip="#Harmony_Tooltip_RightHand">
						<Label text="#Harmony_Use_Right_Hand" class="half-width" />
						<CSGOSettingsEnumDropDown class="PopupButton White" convar="cl_righthand">
							<Label text="#SFUI_Settings_Enabled" value="1" id="cl_righthand_enabled" />
							<Label text="#SFUI_Settings_Disabled" value="0" id="cl_righthand_disabled" />
						</CSGOSettingsEnumDropDown>
					</TooltipPanel>

					<Panel class="horizontal-separator" />

					<TooltipPanel id="HarmonyViewmodelRecoilSelector" class="SettingsMenuDropdownContainer" tooltip="#Harmony_Tooltip_Recoil">
						<Label text="#Harmony_Viewmodel_Recoil" class="half-width" />
						<CSGOSettingsEnumDropDown class="PopupButton White" convar="viewmodel_recoil">
							<Label text="#SFUI_Settings_Enabled" value="1" id="viewmodel_recoil_enabled" />
							<Label text="#SFUI_Settings_Disabled" value="0" id="viewmodel_recoil_disabled" />
						</CSGOSettingsEnumDropDown>
					</TooltipPanel>

					<Panel class="horizontal-separator" />

					<TooltipPanel class="SettingsMenuDropdownContainer" tooltip="#Harmony_Tooltip_FOV">
						<CSGOSettingsSlider id="viewmodel_fov" text="#Harmony_Viewmodel_FOV" max="68" min="54" invert="false" percentage="false" convar="viewmodel_fov" />
					</TooltipPanel>

					<Panel class="horizontal-separator" />

					<TooltipPanel class="SettingsMenuDropdownContainer" tooltip="#Harmony_Tooltip_Offset_X">
						<CSGOSettingsSlider id="viewmodel_offset_x" text="#Harmony_Viewmodel_Offset_X" max="2.5" min="-2.5" invert="false" percentage="false" convar="viewmodel_offset_x" />
					</TooltipPanel>

					<Panel class="horizontal-separator" />

					<TooltipPanel class="SettingsMenuDropdownContainer" tooltip="#Harmony_Tooltip_Offset_Y">
						<CSGOSettingsSlider id="viewmodel_offset_y" text="#Harmony_Viewmodel_Offset_Y" max="2" min="-2" invert="false" percentage="false" convar="viewmodel_offset_y" />
					</TooltipPanel>

					<Panel class="horizontal-separator" />

					<TooltipPanel class="SettingsMenuDropdownContainer" tooltip="#Harmony_Tooltip_Offset_Z">
						<CSGOSettingsSlider id="viewmodel_offset_z" text="#Harmony_Viewmodel_Offset_Z" max="2" min="-2" invert="false" percentage="false" convar="viewmodel_offset_z" />
					</TooltipPanel>
				</Panel>
			</Panel>
		</Panel>

		<Panel class="content-controls-actions-bar">
			<Panel class="left-right-flow vertical-center horizontal-align-right">
				<Button id="SettingsRestoreKbMouse"
					class="PopupButton White"
					onactivate="SettingsMenuShared.ShowConfirmReset( SettingsMenuShared.ResetVideoSettings, '#Harmony_Reset_Confirm_Msg' );"
					onmouseover="UiToolkitAPI.ShowTextTooltip( 'SettingsRestoreKbMouse', '#tooltip_reset_defaults' );"
					onmouseout="UiToolkitAPI.HideTextTooltip();">
					<Image id="PermissionsSettingsImg" texturewidth="-1" textureheight="28" src="file://{images}/icons/ui/recent.svg" />
					<Label text="#settings_reset_video" />
				</Button>

				<Button id="BtnDiscardVideoSettingChanges"
					class="PopupButton White"
					disabled="true"
					onactivate="SettingsMenuShared.ShowConfirmDiscard( SettingsMenuShared.VideoSettingsDiscardChanges );">
					<Label text="#settings_discard_confirm_title" />
				</Button>

				<Button class="PopupButton White"
					id="BtnApplyVideoSettings"
					disabled="true"
					onactivate="SettingsMenuShared.VideoSettingsApplyChanges();">
					<Label text="#settings_apply_video" />
				</Button>
			</Panel>
		</Panel>
	</Panel>
</root>