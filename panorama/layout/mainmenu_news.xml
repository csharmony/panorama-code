<root>
	<styles>
		<include src="file://{resources}/styles/csgostyles.css" />
		<include src="file://{resources}/styles/mainmenu.css" />
		<include src="file://{resources}/styles/mainmenu_news.css" />
	</styles>

	<scripts>
		<include src="file://{resources}/scripts/mainmenu_news.js" />
	</scripts>


	<Panel class="news-panel MainMenuModeOnly">
		<Panel style="margin: 12px 0px 0px 12px;" class="news-panel-navbar">
			<Image class="news-panel-navbar-logo news-panel-navbar-worldwide" textureheight="18" texturewidth="-1" src="file://{images}/icons/ui/message.svg" />
			<Image class="news-panel-navbar-logo news-panel-navbar-pwglobal" textureheight="18" texturewidth="-1" src="file://{images}/icons/ui/globe.svg" />
			<Image class="news-panel-navbar-logo news-panel-navbar-pwchina" textureheight="18" texturewidth="-1" src="file://{images}/icons/ui/ct_silhouette.svg" />
			<Label html="false" text="#SFUI_MainMenu_News_Title" />
		</Panel>
		<HTML id="HarmonyBlogHTML" 
				class="full-width full-height" 
				acceptsinput="true" 
				acceptsfocus="true" 
				focusonhover="true" 
				mousetracking="true" 
				popuplinks="false" 
				url="https://harmony.heapy.xyz/blog" />
	</Panel>
</root>



	                                             
		                                         
                                                            
					                              
						                                               
                    		                                   
                        		                                              
                    		         
							                           
								                                                                       
							        
                		        
                		                                                
                    		                                   
                        		                                                 
                   			         
						        
					        
				        
				                             
					                                                  	
					                                                                                                                                                 
				        
		        
	            